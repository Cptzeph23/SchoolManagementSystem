# =============================================================================
# SMS + LMS Platform — Environment Variable Template
# Path in repo: SMS/.env.example  (same level as manage.py)
#
# Copy to `.env` in this same folder and fill in real values.
# NEVER commit the real `.env` — it's already in .gitignore.
# =============================================================================

# --- Core Django ------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# development | production | testing
DJANGO_ENV=development
# DJANGO_DEBUG is only read when DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Set True only if you need SSL locally too. Production forces this on
# automatically regardless of this value (see settings.py).
DB_SSL_REQUIRE=False

# --- Supabase (used starting in the storage-integration phase) -------------
# Placeholders now — Phase 1 does not call Supabase Storage yet.
# The service role key must NEVER be exposed to the browser or Flutter app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only

# --- Redis / Celery (used starting in the background-processing phase) -----
REDIS_URL=redis://localhost:6379/0

# --- Email (used starting in the communication-module phase) ---------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True

# --- Payment providers (used starting in the finance phase) ----------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
